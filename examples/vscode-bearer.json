{
  "inputs": [
    {
      "type": "promptString",
      "id": "calven-mcp-key",
      "description": "Calven personal MCP key",
      "password": true
    }
  ],
  "servers": {
    "calven": {
      "type": "http",
      "url": "https://api.calven.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${input:calven-mcp-key}"
      }
    }
  }
}
